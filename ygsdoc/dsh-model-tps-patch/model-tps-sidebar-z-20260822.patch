+function splitModelName(name: string): { prefix: string | undefined; leaf: string } {
+  const at = name.lastIndexOf('/')
+  return at < 0 ? { prefix: undefined, leaf: name } : { prefix: name.slice(0, at), leaf: name.slice(at + 1) }
